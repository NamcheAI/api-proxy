{
  "name": "tashi",
  "url": "https://tashi.namche.ai",
  "hook_attributes": {
    "url": "https://api.namche.ai/v1/webhooks/apps/github-app",
    "active": true
  },
  "public": false,
  "default_permissions": {
    "contents": "read",
    "metadata": "read",
    "pull_requests": "write",
    "checks": "write"
  },
  "default_events": [
    "pull_request",
    "pull_request_review",
    "issue_comment"
  ]
}
